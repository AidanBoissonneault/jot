{
  "name": "inkwell",
  "description": "Capture web highlights into structured Notion projects without breaking flow.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:server": "pnpm --filter @inkwell/worker dev",
    "test": "vitest run",
    "smoke:sync": "tsx scripts/inkwell-sync-smoke.ts",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "vue-tsc --noEmit",
    "typecheck": "pnpm compile && pnpm --filter @inkwell/worker typecheck",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.2.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-audio": "^3.31.3",
    "@tiptap/extension-code-block": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-youtube": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "lowlight": "^3.3.0",
    "parse5": "8.0.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260509.1",
    "@types/node": "^22.19.18",
    "@wxt-dev/module-vue": "^1.0.3",
    "fallow": "^2.73.0",
    "postcss": "^8.5.28",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.8",
    "wrangler": "4.130.0",
    "wxt": "^0.20.25"
  }
}
